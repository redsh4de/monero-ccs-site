[Unit]
Description=Write the CCS values from ccs-back's JSON
OnSuccess=ccs-push.service

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=ccs-backend
ExecStart=/usr/local/lib/ccs/current/deploy/backend/values.py /var/lib/ccs-backend/values
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
