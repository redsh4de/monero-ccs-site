[Unit]
Description=Compare the live CCS site with its own render, over Tor
Wants=tor.service
After=tor.service

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=ccs-monitor
# the alerts' state: in memory, and kept between runs
RuntimeDirectory=ccs-monitor
RuntimeDirectoryPreserve=yes
# every request goes through Tor's socket, and the empty network of its own
# keeps the wallet's RPC and other local services out of reach
Environment=ALL_PROXY=socks5h://localhost/run/tor/socks
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
UMask=0077
ExecStart=/usr/local/lib/ccs/current/deploy/backend/monitor.sh
LoadCredential=alert_url:/etc/ccs/alert_url
LoadCredential=heartbeat_url:/etc/ccs/heartbeat_url
MemoryMax=1G
TimeoutStartSec=1800
