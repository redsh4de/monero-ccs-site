{
  "name": "monero-ccs-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=11.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.4.0"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "render": "sh dev/render.sh",
    "test": "sh tests/run.sh",
    "test:deploy": "pnpm build >/dev/null && sh tests/deploy/run.sh",
    "preview": "sh dev/preview.sh",
    "check": "astro check && eslint . && stylelint \"src/**/*.{css,astro}\" && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "astro": "^7.3.2"
  },
  "packageManager": "pnpm@11.4.0",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss-html": "^1.8.1",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
