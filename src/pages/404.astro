---
import Layout from "@/layouts/Layout.astro";
import { stages } from "@/data/stages";
---

<Layout title="Page not found" fill>
  <div class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p>This page does not exist. Look for a proposal in the lists below.</p>

    <nav aria-label="Proposal lists">
      <a href="/">Home</a>
      {stages.map((stage) => <a href={`/${stage.slug}/`}>{stage.label}</a>)}
    </nav>
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;

    &::before,
    &::after {
      flex: 1;
      content: "";
    }

    &::after {
      flex-grow: 2;
    }

    p {
      margin: 0;
      color: var(--paragraph-main);
    }

    .code {
      font-size: clamp(6rem, 15vw, 10rem);
      font-weight: var(--font-weight-extra-bold);
      line-height: 1;
      color: var(--monero-orange);
    }
  }

  h1 {
    margin: 0;
    font-size: var(--font-size-3xl);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md) var(--space-xl);
    margin-block-start: var(--space-md);
    font-weight: var(--font-weight-semibold);
  }
</style>
