---
import HomeHero from "@/components/pages/index/HomeHero.astro";
import HowItWorks from "@/components/pages/index/HowItWorks.astro";
import NeedsFunding from "@/components/pages/index/NeedsFunding.astro";
import Layout from "@/layouts/Layout.astro";
import StageLayout from "@/layouts/StageLayout.astro";

const intro =
  "Monero is a decentralized, community driven project. The CCS is a way for the community to fund development and other initiatives that benefit the Monero ecosystem.";
---

<Layout description={intro}>
  <StageLayout current="home">
    <div class="home">
      <HomeHero {intro} />
      <NeedsFunding />
      <HowItWorks />
    </div>
  </StageLayout>
</Layout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
    padding-block-end: var(--space-md);
  }
</style>
