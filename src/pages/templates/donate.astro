---
import Button from "@/components/ui/Button.astro";
import DonationAddress from "@/components/ui/DonationAddress.astro";
import StageCard from "@/components/ui/StageCard.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
// a template: the render passes the General Fund as `it`
---

<ContentLayout frontmatter={{ title: "Donate to the Monero Project" }}>
  <p>
    By donating to the following Monero address (General Fund), you are
    supporting the Monero Project. If you wish to donate to a specific proposal,
    please see <a href="/funding-required/">Funding Required</a>.
  </p>

  <Fragment slot="after">
    <StageCard as="section" class="general-fund" aria-label="General Fund">
      [% if it.address %]<DonationAddress />
      <Button href="monero:[[ it.address ]]">Open in wallet</Button>[% else %]<p
      >
        The donation address isn't available right now.
      </p>[% endif %]
    </StageCard>
  </Fragment>
</ContentLayout>

<style>
  .general-fund {
    --stage-color: var(--monero-orange);
    --qr-size: 250px;

    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  /* phones keep the card full width */
  @media (width >= 600px) {
    .general-fund {
      align-self: center;
      inline-size: 21rem;
    }
  }
</style>
