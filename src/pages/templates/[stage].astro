---
import ProposalCard from "@/components/pages/proposals/ProposalCard.astro";
import Button from "@/components/ui/Button.astro";
import MaskIcon from "@/components/ui/icons/MaskIcon.astro";
import Layout from "@/layouts/Layout.astro";
import StageLayout from "@/layouts/StageLayout.astro";
import { type StageName, stages } from "@/lib/stages";

export function getStaticPaths() {
  return stages.map((stage) => ({
    params: { stage: stage.slug },
    props: stage,
  }));
}

interface Props {
  name: StageName;
  label: string;
}

const { name, label } = Astro.props;
---

<Layout title={label}>
  <StageLayout current={name}>
    <div class="heading">
      <h1>{label}</h1>
      {
        name === "funding-required" && (
          <Button href="/feed.xml" variant="text" class="feed">
            <MaskIcon name="rss" />
            RSS feed
          </Button>
        )
      }
    </div>

    {
      name === "idea" && (
        <div class="idea-intro">
          <p>Pitch an idea to the community for discussion.</p>
          <Button href="/how-to-ccs/">Submit Idea</Button>
        </div>
      )
    }

    <div class="proposals">
      [% for it in cards %]<ProposalCard />[% else %]<p class="empty">
        Nothing here right now.
      </p>[% endfor %]
    </div>
  </StageLayout>
</Layout>

<style>
  h1 {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-2xl);
  }

  .heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
  }

  .feed {
    --icon-color: var(--monero-orange);
    --icon-size: 1.25em;

    gap: var(--space-xs);
    margin-inline-start: auto;
  }

  .idea-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-block-end: var(--space-md);

    p {
      margin: 0;
      color: var(--text-secondary);
    }
  }

  .proposals {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .empty {
    margin-block-start: var(--space-2xl);
    text-align: center;
    color: var(--text-secondary);
  }

  @media (width >= 1200px) {
    h1 {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .feed {
      margin-block-end: var(--space-md);
    }

    .idea-intro {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .empty {
      margin-block-start: 0;
      text-align: start;
    }
  }
</style>
