---
import { getCollection } from "astro:content";

import ProposalMeta from "@/components/ProposalMeta.astro";
import ProposalProgress from "@/components/ProposalProgress.astro";
import ProposalSummary from "@/components/ProposalSummary.astro";
import BackLink from "@/components/ui/BackLink.astro";
import BottomBar from "@/components/ui/BottomBar.astro";
import Button from "@/components/ui/Button.astro";
import SectionTabs from "@/components/ui/tabs/SectionTabs.astro";
import Layout from "@/layouts/Layout.astro";
import type { Proposal } from "@/lib/proposals";
import { stages } from "@/lib/stages";
import { safeMarkdown } from "@/utils/safeMarkdown";

export async function getStaticPaths() {
  const entries = await getCollection("proposals", (entry) =>
    entry.data.url.startsWith("/proposals/"),
  );
  return entries.map(({ data }) => ({
    params: { id: data.id },
    props: { proposal: data },
  }));
}

interface Props {
  proposal: Proposal;
}

const { proposal } = Astro.props;

const stage = stages.find((item) => item.status === proposal.status);

const summaryHeading = stage?.summary;

const meta = [
  { icon: "user", text: proposal.author },
  { icon: "calendar", text: proposal.date },
].filter((item) => item.text);

const tabs = [{ label: "Proposal" }, { label: "Milestones" }];
if (proposal.status === "work-in-progress" || proposal.status === "completed") {
  tabs.push({ label: "Payouts" });
}
---

<Layout title={proposal.title}>
  <div
    class="proposal"
    style={`--stage-color: ${stage?.color ?? "var(--border-color)"}`}
  >
    <BackLink href={stage ? `/${stage.slug}/` : "/"}>
      {stage?.label ?? "Home"}
    </BackLink>

    <div class="columns">
      <div class="heading">
        <h1>{proposal.title}</h1>
        <ProposalMeta items={meta} />
      </div>

      {
        summaryHeading && (
          <div class="side">
            <ProposalSummary {proposal} heading={summaryHeading} />
          </div>
        )
      }

      <div class="sections">
        <SectionTabs {tabs}>
          <Fragment slot="panel-0">
            <article class="prose" set:html={safeMarkdown(proposal.body)} />
            {
              proposal.gitlabUrl && (
                <div class="discussion">
                  <h2>Community discussion and updates</h2>
                  <a
                    href={proposal.gitlabUrl}
                    target="_blank"
                    rel="noopener noreferrer external"
                  >
                    View community discussion, comments, and proposal updates on
                    GitLab
                  </a>
                </div>
              )
            }
          </Fragment>

          <Fragment slot="panel-1">
            {
              proposal.milestones.length > 0 ? (
                <ol class="milestones">
                  {proposal.milestones.map((milestone) => (
                    <li>
                      <h2>{milestone.name}</h2>
                      <span>
                        {milestone.finished ? "Finished" : "Unfinished"}
                      </span>
                      {milestone.funds && <p>To be paid: {milestone.funds}</p>}
                      {milestone.done && (
                        <p>Completion date: {milestone.done}</p>
                      )}
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="empty">No milestones listed.</p>
              )
            }
          </Fragment>

          <Fragment slot="panel-2">
            {
              proposal.payouts.length > 0 ? (
                <table>
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Funds awarded</th>
                    </tr>
                  </thead>
                  <tbody>
                    {proposal.payouts.map((payout) => (
                      <tr>
                        <td>{payout.date}</td>
                        <td>{payout.amount}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <p class="empty">No payouts yet.</p>
              )
            }
          </Fragment>
        </SectionTabs>
      </div>
    </div>

    {
      proposal.address && (
        <BottomBar>
          <div class="contribute-row">
            <ProposalProgress {proposal} />
            <Button {...{ popovertarget: "summary" }}>Contribute</Button>
          </div>
        </BottomBar>
      )
    }
  </div>
</Layout>

<style>
  .proposal {
    --proposal-width: 80rem;
    --summary-width: 21rem;

    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    inline-size: 100%;
    max-inline-size: var(--proposal-width);
    margin-inline: auto;
  }

  .columns,
  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-title);
  }

  .prose {
    max-inline-size: 75ch;
    color: var(--paragraph-main);

    h1,
    h2 {
      margin: var(--space-xl) 0 var(--space-xs);
      font-size: var(--font-size-xl);
    }

    h3,
    h4,
    h5,
    h6 {
      margin: var(--space-lg) 0 var(--space-xs);
      font-size: var(--font-size-lg);
    }

    > :first-child {
      margin-block-start: 0;
    }

    p,
    ul,
    ol {
      margin-block: 0 var(--space-md);
    }

    a {
      color: var(--orange-text);
      text-decoration: underline;
    }

    img {
      max-inline-size: 100%;
      block-size: auto;
    }

    pre {
      padding: var(--space-md);
      overflow-x: auto;
      background: var(--card-color);
      border-radius: var(--radius-md);
    }

    code {
      font-size: 0.9em;
    }

    blockquote {
      margin: 0 0 var(--space-md);
      padding-inline-start: var(--space-md);
      border-inline-start: 3px solid var(--border-color);
    }

    table {
      display: block;
      overflow-x: auto;
    }
  }

  .discussion {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--border-color);

    h2 {
      margin: 0 0 var(--space-xs);
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
    }

    a {
      color: var(--orange-text);
    }
  }

  .milestones {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2xs) var(--space-md);
      padding: var(--space-md);
      background: var(--card-color);
      border-radius: var(--radius-md);
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
    }

    h2 {
      margin: 0;
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-semibold);
    }

    p {
      grid-column: 1 / -1;
      margin: 0;
    }
  }

  .empty {
    margin: 0;
    color: var(--text-secondary);
  }

  .contribute-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    block-size: 100%;
    padding-inline: var(--mobile-padding-inline);

    .proposal-progress {
      flex: 1;
      min-inline-size: 0;
    }

    .progress-text {
      text-align: start;
    }
  }

  @media (width >= 1200px) {
    .columns:has(.side) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--summary-width);
      grid-template-rows: auto 1fr;
      gap: var(--space-md) var(--space-4xl);
    }

    .heading,
    .sections {
      grid-column: 1;
    }

    .side {
      position: sticky;
      inset-block-start: var(--sticky-top);
      grid-area: 1 / 2 / -1;
      align-self: start;
    }

    .contribute-row {
      display: none;
    }
  }
</style>
