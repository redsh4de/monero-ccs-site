---
import { getCollection } from "astro:content";

import ContributeBar from "@/components/pages/proposals/ContributeBar.astro";
import ProposalBody from "@/components/pages/proposals/ProposalBody.astro";
import ProposalMeta from "@/components/pages/proposals/ProposalMeta.astro";
import ProposalMilestones from "@/components/pages/proposals/ProposalMilestones.astro";
import ProposalSummary from "@/components/pages/proposals/ProposalSummary.astro";
import BackLink from "@/components/ui/BackLink.astro";
import SectionTabs from "@/components/ui/tabs/SectionTabs.astro";
import Layout from "@/layouts/Layout.astro";
import type { Proposal } from "@/lib/proposals";
import { stages } from "@/lib/stages";

export async function getStaticPaths() {
  const entries = await getCollection("proposals", (entry) =>
    entry.data.url.startsWith("/proposals/"),
  );
  return entries.map(({ data }) => ({
    params: { id: data.id },
    props: { proposal: data },
  }));
}

interface Props {
  proposal: Proposal;
}

const { proposal } = Astro.props;

const stage = stages.find((item) => item.status === proposal.status);

const summaryHeading = proposal.fullyFunded ? "Fully funded" : stage?.summary;

const meta = [
  { icon: "user", text: proposal.author },
  { icon: "calendar", text: proposal.date },
].filter((item) => item.text);

const tabs = [{ label: "Proposal" }, { label: "Milestones" }];
if (proposal.status === "work-in-progress" || proposal.status === "completed") {
  tabs.push({ label: "Payouts" });
}
---

<Layout title={proposal.title}>
  <div
    class="proposal"
    style={`--stage-color: ${stage?.color ?? "var(--border-color)"}`}
  >
    <BackLink href={stage ? `/${stage.slug}/` : "/"}>
      {stage?.label ?? "Home"}
    </BackLink>

    <div class="columns">
      <div class="heading">
        <h1>{proposal.title}</h1>
        <ProposalMeta items={meta} />
      </div>

      {
        summaryHeading && (
          <div class:list={["side", { "desktop-only": proposal.fullyFunded }]}>
            <ProposalSummary {proposal} heading={summaryHeading} />
          </div>
        )
      }

      <SectionTabs {tabs}>
        <Fragment slot="panel-0">
          <ProposalBody body={proposal.body} />
          {
            proposal.gitlabUrl && (
              <div class="discussion">
                <h2>Community discussion and updates</h2>
                <a
                  href={proposal.gitlabUrl}
                  target="_blank"
                  rel="noopener noreferrer external"
                >
                  View community discussion, comments, and proposal updates on
                  GitLab
                </a>
              </div>
            )
          }
        </Fragment>

        <Fragment slot="panel-1">
          {
            proposal.milestones.length > 0 ? (
              <ProposalMilestones milestones={proposal.milestones} />
            ) : (
              <p class="empty">No milestones listed.</p>
            )
          }
        </Fragment>

        <Fragment slot="panel-2">
          {
            proposal.payouts.length > 0 ? (
              <table>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Funds awarded</th>
                  </tr>
                </thead>
                <tbody>
                  {proposal.payouts.map((payout) => (
                    <tr>
                      <td>{payout.date}</td>
                      <td>{payout.amount}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <p class="empty">No payouts yet.</p>
            )
          }
        </Fragment>
      </SectionTabs>
    </div>

    <ContributeBar {proposal} />
  </div>
</Layout>

<style>
  .proposal {
    --proposal-width: 80rem;
    --summary-width: 21rem;

    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    inline-size: 100%;
    max-inline-size: var(--proposal-width);
    margin-inline: auto;
  }

  .columns,
  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-title);
  }

  .discussion {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--border-color);

    h2 {
      margin: 0 0 var(--space-xs);
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
    }

    a {
      color: var(--orange-text);
    }
  }

  .empty {
    margin: 0;
    color: var(--text-secondary);
  }

  @media (width < 1200px) {
    .desktop-only {
      display: none;
    }
  }

  @media (width >= 1200px) {
    .columns:has(.side) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--summary-width);
      grid-template-rows: auto 1fr;
      gap: var(--space-md) var(--space-4xl);
    }

    .side {
      position: sticky;
      inset-block-start: var(--sticky-top);
      grid-area: 1 / 2 / -1;
      align-self: start;
    }
  }
</style>
