---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import landingImage from "@/assets/funding-required.png";
import ProposalCard from "@/components/pages/proposals/ProposalCard.astro";
import StageLayout from "@/layouts/StageLayout.astro";
import MaskIcon from "@/components/ui/icons/MaskIcon.astro";
import Layout from "@/layouts/Layout.astro";
import { stages } from "@/lib/stages";
import { icons } from "@/utils/icons";

const entries = await getCollection(
  "proposals",
  (entry) => entry.data.status === "funding-required",
);
const funding = entries.map((entry) => entry.data);
const needsFunding = funding.filter((proposal) => !proposal.fullyFunded);
---

<Layout>
  <StageLayout current="home">
    <div class="home">
      <div class="hero">
        <Image src={landingImage} alt="" width={232} loading="eager" />
        <h1>Community Crowdfunding System</h1>
        <p>
          Monero is a decentralized, community driven project. The CCS is a way
          for the community to fund development and other initiatives that
          benefit the Monero ecosystem.
        </p>
      </div>

      <section aria-labelledby="funding-title">
        <div class="section-heading">
          <h2 id="funding-title">Needs funding</h2>
          {
            funding.length > 4 && (
              <a href="/funding-required/">See all {funding.length}</a>
            )
          }
        </div>
        {
          needsFunding.length > 0 ? (
            <div class="funding">
              {needsFunding.slice(0, 4).map((proposal) => (
                <ProposalCard {proposal} variant="simple" />
              ))}
            </div>
          ) : (
            <p class="empty">Nothing needs funding right now.</p>
          )
        }
      </section>

      <section aria-labelledby="how-title">
        <div class="section-heading">
          <h2 id="how-title">How it works</h2>
          <a href="/about/">Learn more</a>
        </div>
        <ol class="steps">
          {
            stages.map((stage) => (
              <li class="card" style={`--stage-color: ${stage.color}`}>
                <div class="step-title">
                  <span class="step-icon">
                    <MaskIcon src={icons.mask(stage.icon)} size="1rem" />
                  </span>
                  <h3>
                    <a href={`/${stage.slug}/`}>{stage.short}</a>
                  </h3>
                </div>
                <p>{stage.description}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </StageLayout>
</Layout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
    padding-block-end: var(--space-md);
  }

  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-sm) var(--space-md);

    img {
      inline-size: 3.75rem;
      block-size: auto;
    }

    h1 {
      margin: 0;
      font-size: var(--font-size-2xl);
      line-height: var(--line-height-title);
      color: var(--orange-text);
    }

    p {
      grid-column: 1 / -1;
      margin: 0;
      color: var(--text-secondary);
    }
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-sm);

    h2 {
      margin: 0;
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-semibold);
    }

    a {
      color: var(--orange-text);
    }
  }

  .funding {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-md);
  }

  .empty {
    margin: 0;
    color: var(--text-secondary);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      padding: var(--space-md);
    }

    h3 {
      margin: 0;
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-semibold);
    }

    a {
      color: var(--heading-color);
      font-weight: inherit;

      &::after {
        content: "";
        position: absolute;
        inset: -4px 0 0;
        border-radius: inherit;
      }

      &:hover {
        text-decoration: none;
      }

      &:focus-visible {
        outline: none;
      }

      &:focus-visible::after {
        outline: 2px solid currentcolor;
        outline-offset: -2px;
      }
    }

    p {
      margin: 0;
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
    }

    .step-title {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
    }

    .step-icon {
      display: flex;
      flex: none;
      align-items: center;
      justify-content: center;
      inline-size: 1.75rem;
      block-size: 1.75rem;
      background: var(--stage-color);
      border-radius: var(--radius-full);
      color: white;
    }
  }

  @media (width < 375px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width >= 1200px) {
    .funding {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .hero {
      gap: var(--space-xs) var(--space-lg);

      img {
        grid-row: 1 / 3;
        inline-size: 7.25rem;
      }

      h1 {
        align-self: end;
        font-size: var(--font-size-3xl);
      }

      p {
        grid-column: 2;
        align-self: start;
        text-wrap: pretty;
      }
    }
  }
</style>
