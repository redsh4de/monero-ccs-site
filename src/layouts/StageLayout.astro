---
import { getCollection } from "astro:content";

import BackLink from "@/components/ui/BackLink.astro";
import BottomBar from "@/components/ui/BottomBar.astro";
import MaskIcon from "@/components/ui/icons/MaskIcon.astro";
import { type ProposalStatus, stages } from "@/lib/stages";
import { icons } from "@/utils/icons";

interface Props {
  current: ProposalStatus | "home";
}

const { current } = Astro.props;

const proposals = await getCollection("proposals");
const count = (status: string) =>
  proposals.filter((entry) => entry.data.status === status).length;
---

<div class:list={["stage-layout", { "no-sidebar": current === "home" }]}>
  <aside class="sidebar">
    <div class="home-back">
      <BackLink href="/">Home</BackLink>
    </div>
    <BottomBar>
      <nav class="stages" aria-label="Proposal stages">
        <a
          href="/"
          class="stage home-tab"
          aria-current={current === "home" ? "page" : undefined}
        >
          <MaskIcon src={icons.mask("house")} size="1.375rem" />
          <span>Home</span>
        </a>
        {
          stages.map((stage) => (
            <a
              href={`/${stage.slug}/`}
              class="stage"
              aria-current={current === stage.status ? "page" : undefined}
              style={`--stage-color: ${stage.color}`}
            >
              <span class="stage-icon">
                <MaskIcon src={icons.mask(stage.icon)} size="1.375rem" />
              </span>
              <span class="label">{stage.label}</span>
              <span class="short">{stage.short}</span>
              <span class="count">{count(stage.status)}</span>
            </a>
          ))
        }
      </nav>
    </BottomBar>
  </aside>

  <div>
    <slot />
  </div>
</div>

<style>
  .stage-layout {
    inline-size: 100%;
    max-inline-size: 48rem;
    margin-inline: auto;
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    color: var(--text-secondary);
    font-size: var(--font-size-xs);
    text-decoration: none;

    &[aria-current="page"] {
      color: var(--orange-text);
      font-weight: var(--font-weight-bold);
    }
  }

  .stage-icon {
    display: flex;
  }

  @media (width < 1200px) {
    .label,
    .count,
    .home-back {
      display: none;
    }

    .stages {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      block-size: 100%;
    }
  }

  @media (width >= 1200px) {
    /* equal side columns keep the content centered on the page */
    .stage-layout {
      --side: minmax(14rem, 1fr);

      display: grid;
      grid-template-columns: var(--side) minmax(0, 48rem) var(--side);
      gap: var(--space-2xl);
      align-items: start;
      max-inline-size: none;
    }

    .sidebar {
      position: sticky;
      inset-block-start: var(--sticky-top);
      justify-self: end;
      inline-size: 14rem;
    }

    .no-sidebar {
      display: block;
      max-inline-size: 67rem;

      .sidebar {
        display: none;
      }
    }

    .home-back {
      margin-block-end: var(--space-md);
    }

    .home-tab {
      display: none;
    }

    .stages {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .stage {
      flex-direction: row;
      justify-content: flex-start;
      gap: var(--space-xs);
      min-block-size: 3rem;
      padding-inline: var(--space-sm);
      background: var(--card-color);
      border-radius: var(--radius-md);
      color: var(--heading-color);
      font-size: var(--font-size-base);

      &:hover {
        background: var(--card-hover-color);
      }

      &[aria-current="page"] {
        background: var(--card-hover-color);
        box-shadow: inset 0 0 0 1.5px var(--orange-text);
        font-weight: var(--font-weight-semibold);
      }
    }

    .stage-icon {
      color: var(--stage-color);
    }

    .label {
      flex: 1;
    }

    .count {
      color: var(--text-secondary);
      font-variant-numeric: tabular-nums;
    }

    [aria-current="page"] .count {
      color: inherit;
    }

    .short {
      display: none;
    }
  }
</style>
