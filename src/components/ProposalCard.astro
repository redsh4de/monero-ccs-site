---
import ProposalMeta from "@/components/ProposalMeta.astro";
import ProposalProgress from "@/components/ProposalProgress.astro";
import type { Proposal } from "@/lib/proposals";
import { stages } from "@/lib/stages";

interface Props {
  proposal: Proposal;
  variant?: "full" | "simple";
}

const { proposal, variant = "full" } = Astro.props;

const color =
  stages.find((stage) => stage.status === proposal.status)?.color ??
  "var(--border-color)";
const Tag = proposal.url ? "a" : "div";
const simple = variant === "simple";
const Title = simple ? "h3" : "h2";

const meta = [
  { icon: "user", text: proposal.author, show: proposal.author },
  { icon: "calendar", text: proposal.date, show: !simple && proposal.date },
  {
    icon: "users",
    text: `${proposal.contributions} contributions`,
    show: proposal.status !== "idea",
  },
  {
    icon: "coins",
    text: `${proposal.amount} XMR`,
    show: !simple && proposal.amount,
  },
];
---

<Tag
  href={proposal.url || undefined}
  class="proposal-card"
  data-variant={variant}
  style={`--progress-color: ${color}`}
>
  <Title class="proposal-title">{proposal.title}</Title>
  <ProposalMeta items={meta.filter((item) => item.show)} />
  <ProposalProgress {proposal} />
</Tag>

<style>
  .proposal-card {
    display: block;
    background: var(--card-color);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    box-shadow: var(--shadow-sm);
    border-top: 6px solid var(--progress-color);
    padding: var(--space-lg);
    text-decoration: none;
    color: inherit;
    font-weight: var(--font-weight-normal);
    overflow-wrap: anywhere;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;

    .proposal-progress {
      margin-block-start: var(--space-lg);
    }
  }

  a.proposal-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .proposal-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    margin: 0 0 var(--space-md);
  }

  .proposal-card[data-variant="simple"] {
    display: flex;
    flex-direction: column;
    padding: var(--space-md) var(--space-lg);

    .proposal-title {
      font-size: 1.0625rem;
      margin-block-end: var(--space-xs);
    }

    .proposal-meta {
      gap: var(--space-2xs) var(--space-md);
    }

    .proposal-progress {
      margin-block-start: auto;
      padding-block-start: var(--space-md);
    }
  }
</style>
