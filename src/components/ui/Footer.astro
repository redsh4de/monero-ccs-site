---
import { externalLinks } from "@/lib/links";
---

<footer class="footer">
  <div class="footer-inner">
    <nav class="links" aria-label="Footer navigation">
      <ul class="link-list">
        {
          externalLinks.map(({ label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer external">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-color);
    margin-top: auto;
  }

  .footer-inner {
    padding: var(--space-4xl) var(--desktop-padding-inline);
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    align-items: center;
    text-align: center;
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    justify-content: center;

    a {
      color: var(--heading-color);
      text-decoration: none;
      display: flex;
      align-items: center;
      width: fit-content;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  /* these links move into the header menu whenever it's a drawer */
  @media (width < 1200px), (hover: none) {
    .footer {
      display: none;
    }
  }
</style>
