---
import type { HTMLTag } from "astro/types";

interface Props {
  columns: 2 | 3 | 4;
  gap?: "2xs" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "3xl";
  as?: "div" | "ul" | "ol";
  class?: string;
}

const {
  columns,
  gap = "lg",
  as = "div",
  class: className,
  ...rest
}: Props = Astro.props;
const Tag = as as HTMLTag;
---

<Tag
  class:list={["grid", className]}
  data-columns={columns}
  data-gap={gap}
  {...rest}
>
  <slot />
</Tag>

<style>
  .grid {
    --grid-gap: var(--space-lg);
    --gap-count: calc(var(--grid-col-count) - 1);
    --total-gap-width: calc(var(--gap-count) * var(--grid-gap));
    --grid-max-width: calc(
      (100% - var(--total-gap-width)) / var(--grid-col-count)
    );

    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, max(var(--grid-min-width), var(--grid-max-width))), 1fr)
    );

    &:is(ul, ol) {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    &[data-columns="2"] {
      --grid-col-count: 2;
      --grid-min-width: 25rem;
    }

    &[data-columns="3"] {
      --grid-col-count: 3;
      --grid-min-width: 18rem;
    }

    &[data-columns="4"] {
      --grid-col-count: 4;
      --grid-min-width: 14rem;
    }

    &[data-gap="2xs"] {
      --grid-gap: var(--space-2xs);
    }

    &[data-gap="xs"] {
      --grid-gap: var(--space-xs);
    }

    &[data-gap="sm"] {
      --grid-gap: var(--space-sm);
    }

    &[data-gap="md"] {
      --grid-gap: var(--space-md);
    }

    &[data-gap="xl"] {
      --grid-gap: var(--space-xl);
    }

    &[data-gap="2xl"] {
      --grid-gap: var(--space-2xl);
    }

    &[data-gap="3xl"] {
      --grid-gap: var(--space-3xl);
    }
  }
</style>
