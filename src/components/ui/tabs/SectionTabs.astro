---
import { stableId } from "@/utils/stableId";

interface Tab {
  label: string;
  count?: number;
  // a template condition: the tab shows only if it holds
  when?: string;
}

interface Props {
  tabs: Tab[];
  class?: string;
}

const { tabs, class: className } = Astro.props;

if (!tabs || tabs.length === 0) {
  throw new Error("<SectionTabs> requires at least one tab");
}

const uid = `stabs-${stableId(tabs.map((t) => t.label))}`;
const open = (tab?: Tab) => (tab?.when ? `[% if ${tab.when} %]` : "");
const close = (tab?: Tab) => (tab?.when ? "[% endif %]" : "");
---

<div class:list={["section-tabs", className]} id={uid}>
  {
    tabs.map((tab, index) => (
      <>
        <Fragment set:html={open(tab)} />
        <input
          type="radio"
          name={uid}
          id={`${uid}-${index}`}
          class="tab-input"
          checked={index === 0}
        />
        <Fragment set:html={close(tab)} />
      </>
    ))
  }

  <div class="tab-labels">
    {
      tabs.map((tab, index) => (
        <>
          <Fragment set:html={open(tab)} />
          <label for={`${uid}-${index}`} class="tab-label">
            {tab.label}
            {tab.count !== undefined && (
              <span class="tab-count">{tab.count}</span>
            )}
          </label>
          <Fragment set:html={close(tab)} />
        </>
      ))
    }
  </div>

  <div class="tab-panels">
    {
      tabs[0] && (
        <>
          <Fragment set:html={open(tabs[0])} />
          <div class="tab-panel">
            <slot name="panel-0" />
          </div>
          <Fragment set:html={close(tabs[0])} />
        </>
      )
    }
    {
      tabs[1] && (
        <>
          <Fragment set:html={open(tabs[1])} />
          <div class="tab-panel">
            <slot name="panel-1" />
          </div>
          <Fragment set:html={close(tabs[1])} />
        </>
      )
    }
    {
      tabs[2] && (
        <>
          <Fragment set:html={open(tabs[2])} />
          <div class="tab-panel">
            <slot name="panel-2" />
          </div>
          <Fragment set:html={close(tabs[2])} />
        </>
      )
    }
    {
      tabs[3] && (
        <>
          <Fragment set:html={open(tabs[3])} />
          <div class="tab-panel">
            <slot name="panel-3" />
          </div>
          <Fragment set:html={close(tabs[3])} />
        </>
      )
    }
    {
      tabs[4] && (
        <>
          <Fragment set:html={open(tabs[4])} />
          <div class="tab-panel">
            <slot name="panel-4" />
          </div>
          <Fragment set:html={close(tabs[4])} />
        </>
      )
    }
  </div>
</div>

<style lang="scss">
  .section-tabs {
    position: relative;
  }

  .tab-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tab-labels {
    display: flex;
    gap: var(--space-2xs);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-color);
  }

  .tab-label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--paragraph-subtitle);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;

    &:hover {
      color: var(--heading-color);
    }
  }

  .tab-count {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    background: var(--border-color);
    color: var(--paragraph-subtitle);
    padding: 0.15em 0.5em;
    border-radius: var(--radius-xl);
  }

  .tab-panels {
    position: relative;
  }

  .tab-panel {
    display: none;
  }

  /* hidden tabs still print */
  @media print {
    .tab-panel {
      display: block;
    }
  }

  @for $i from 1 through 5 {
    .tab-input:nth-of-type(#{$i}):checked
      ~ .tab-labels
      .tab-label:nth-child(#{$i}) {
      color: var(--orange-text);
      border-bottom-color: var(--orange-text);

      .tab-count {
        background: color-mix(in srgb, var(--monero-orange) 15%, transparent);
        color: var(--monero-orange);
      }
    }

    .tab-input:nth-of-type(#{$i}):focus-visible
      ~ .tab-labels
      .tab-label:nth-child(#{$i}) {
      outline: 2px solid var(--orange-text);
      outline-offset: -2px;
    }

    .tab-input:nth-of-type(#{$i}):checked
      ~ .tab-panels
      .tab-panel:nth-child(#{$i}) {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .tab-labels {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    .tab-label {
      padding: var(--space-xs) var(--space-sm);
      white-space: nowrap;
    }
  }
</style>
