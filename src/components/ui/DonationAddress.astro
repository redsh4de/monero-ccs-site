---
// a template: the render passes the address as `it.address`
---

<img
  class="qr"
  src="/qr/[[ it.address ]].png"
  alt="QR code for this Monero address"
  width="200"
  height="200"
/>
<code title="Monero address">[[ it.address ]]</code>

<style>
  .qr {
    align-self: center;
    inline-size: var(--qr-size, 12.5rem);
    max-inline-size: 100%;
    block-size: auto;
    image-rendering: pixelated;
    background: white;
    border-radius: var(--radius-md);
  }

  code {
    padding: var(--space-xs) var(--space-sm);
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--heading-color);
    font-size: 0.8125rem;
    line-height: var(--line-height-caption);
    overflow-wrap: anywhere;
    user-select: all;
  }
</style>
