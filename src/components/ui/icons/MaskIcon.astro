---
import "@/styles/icons.css";
import iconRules from "@/styles/icons.css?raw";

// a parent sets the size and colour with --icon-size and --icon-color
export interface Props {
  name: string;
}

const { name } = Astro.props;

// an icon needs its image and its rule in icons.css; Vite doesn't check CSS URLs
const image = `/src/assets/icons/mask/${name}.avif`;
const rule = `.icon-${name} {\n  --icon-src: url("../assets/icons/mask/${name}.avif");\n}`;
if (!import.meta.glob("/src/assets/icons/mask/*.avif")[image]) {
  throw new Error(`No image for icon "${name}": add ${image}`);
}
if (!iconRules.includes(rule)) {
  throw new Error(`No rule for icon "${name}" in src/styles/icons.css`);
}
---

<span class={`icon icon-${name}`}></span>

<style>
  .icon {
    display: inline-block;
    inline-size: var(--icon-size, 1em);
    block-size: var(--icon-size, 1em);
    background: var(--icon-color, currentColor);
    mask: var(--icon-src) no-repeat center / contain;
  }
</style>
