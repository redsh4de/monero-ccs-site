<ol>
  [% for milestone in it.milestones %]
  <li>
    <h2>[[ milestone.name ]]</h2>
    <span
      >[% if milestone.finished %]Finished[% else %]Unfinished[% endif %]</span
    >
    [% if milestone.funds %]<p>To be paid: [[ milestone.funds ]]</p>[% endif %]
    [% if milestone.done %]<p>Completion date: [[ milestone.done ]]</p>[% endif
    %]
  </li>
  [% endfor %]
</ol>

<style>
  ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2xs) var(--space-md);
    padding: var(--space-md);
    background: var(--card-color);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  h2 {
    margin: 0;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
  }

  p {
    grid-column: 1 / -1;
    margin: 0;
  }
</style>
