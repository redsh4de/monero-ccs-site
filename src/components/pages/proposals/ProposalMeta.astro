---
import MaskIcon from "@/components/ui/icons/MaskIcon.astro";

interface Props {
  // when: a template condition; the item shows only if it holds
  items: { icon: string; label?: string; text: string; when?: string }[];
  class?: string;
}

const { items, class: className, ...rest } = Astro.props;
---

<div class:list={["proposal-meta", className]} {...rest}>
  {
    items.map((item) => (
      <>
        <Fragment set:html={item.when ? `[% if ${item.when} %]` : ""} />
        <div class="meta-item">
          <MaskIcon name={item.icon} label={item.label} />
          <span>{item.text}</span>
        </div>
        <Fragment set:html={item.when ? "[% endif %]" : ""} />
      </>
    ))
  }
</div>

<style>
  .proposal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  .meta-item {
    --icon-color: var(--monero-orange);
    --icon-size: 1.25em;

    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
</style>
