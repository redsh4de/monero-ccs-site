---
import MaskIcon from "@/components/ui/icons/MaskIcon.astro";
import { icons } from "@/utils/icons";

interface Props {
  items: { icon: string; text: string }[];
  class?: string;
}

const { items, class: className, ...rest } = Astro.props;
---

<div class:list={["proposal-meta", className]} {...rest}>
  {
    items.map((item) => (
      <div class="meta-item">
        <MaskIcon
          src={icons.mask(item.icon)}
          size="1.25em"
          color="var(--monero-orange)"
        />
        <span>{item.text}</span>
      </div>
    ))
  }
</div>

<style>
  .proposal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
</style>
