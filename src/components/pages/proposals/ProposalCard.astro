---
import ProposalMeta from "@/components/pages/proposals/ProposalMeta.astro";
import ProposalProgress from "@/components/pages/proposals/ProposalProgress.astro";
import CardLink from "@/components/ui/CardLink.astro";
import StageCard from "@/components/ui/StageCard.astro";

// a template: the render passes one card's item as `it`
interface Props {
  variant?: "full" | "simple";
}

const { variant = "full" } = Astro.props;

const simple = variant === "simple";
const Title = simple ? "h3" : "h2";

const author = { icon: "user", text: "[[ it.author ]]", when: "it.author" };
const date = { icon: "calendar", text: "[[ it.date ]]", when: "it.date" };
const contributions = {
  icon: "users",
  text: "[[ it.contributions ]] contribution[% if it.contributions != 1 %]s[% endif %]",
  when: "it.listed",
};
const amount = {
  icon: "coins",
  text: "[[ it.amount ]] XMR",
  when: "it.amount",
};
const meta = simple
  ? [author, contributions]
  : [author, date, contributions, amount];

const votes = [
  { icon: "thumbs-up", label: "Upvotes", text: "[[ it.upvotes ]]" },
  { icon: "thumbs-down", label: "Downvotes", text: "[[ it.downvotes ]]" },
];
---

<StageCard
  as="article"
  class="proposal-card stage-[[ it.stage ]]"
  data-variant={variant}
>
  <Title class="proposal-title">
    [% if it.url %]<CardLink href="[[ it.url ]]">[[ it.title ]]</CardLink>[%
    else %][[ it.title ]][% endif %]
  </Title>
  <ProposalMeta class="meta" items={meta} />
  [% if it.listed %]<ProposalProgress class="progress" />[% endif %] [% if
  it.stage == "idea" %]<ProposalMeta class="votes" items={votes} />[% endif %]
</StageCard>

<style>
  .proposal-card {
    padding: var(--space-lg);
    overflow-wrap: anywhere;
  }

  .progress {
    margin-block-start: var(--space-lg);
  }

  .proposal-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    margin: 0 0 var(--space-md);
  }

  .proposal-card[data-variant="simple"] {
    display: flex;
    flex-direction: column;
    padding: var(--space-md) var(--space-lg);

    .proposal-title {
      font-size: 1.0625rem;
      margin-block-end: var(--space-xs);
    }

    .meta {
      gap: var(--space-2xs) var(--space-md);
    }

    .progress {
      margin-block-start: auto;
      padding-block-start: var(--space-md);
    }
  }

  .proposal-card:has(.votes) {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-md);

    .proposal-title {
      grid-column: 1 / -1;
    }

    .votes {
      align-self: end;
      flex-wrap: nowrap;
      gap: var(--space-md);
      padding: var(--space-2xs) var(--space-md);
      border-radius: var(--radius-md);
      background: var(--secondary-button-color);
    }
  }
</style>
