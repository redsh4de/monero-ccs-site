---
/* eslint-disable astro/jsx-a11y/no-autofocus -- moves focus into the drawer as it opens, never on page load */
import ProposalMeta from "@/components/pages/proposals/ProposalMeta.astro";
import ProposalProgress from "@/components/pages/proposals/ProposalProgress.astro";
import Button from "@/components/ui/Button.astro";
import DonationAddress from "@/components/ui/DonationAddress.astro";
import MaskIcon from "@/components/ui/icons/MaskIcon.astro";
import StageCard from "@/components/ui/StageCard.astro";
import { icons } from "@/utils/icons";

const meta = [
  {
    icon: "coins",
    text: "[[ it.amount ]] XMR",
    when: "it.amount and not it.funding",
  },
  {
    icon: "users",
    text: "[[ it.contributions ]] contribution[% if it.contributions != 1 %]s[% endif %]",
  },
];
---

{
  /* popover is always set, and the drawer class only when donations are open;
   the styles below undo the browser's popover hiding for the plain card */
}
<StageCard
  as="aside"
  id="summary"
  class="summary[% if it.open %] drawer[% endif %]"
  aria-label="[[ it.summary_heading ]]"
  popover="auto"
>
  <div class="details">
    <h2>[[ it.summary_heading ]]</h2>

    <div class="top">
      <div class="numbers">
        <ProposalProgress class="progress" />
        <ProposalMeta items={meta} />
      </div>
      [% if it.open %]<button
        class="close"
        autofocus
        popovertarget="summary"
        popovertargetaction="hide"
        aria-label="Close"
      >
        <MaskIcon src={icons.mask("close")} size="1.25rem" />
      </button>[% endif %]
    </div>

    [% if it.open %]<DonationAddress />[% endif %]
  </div>

  [% if it.address_missing %]<p>
    The donation address isn't available right now.
  </p>[% endif %] [% if it.open %]<Button href="monero:[[ it.address ]]"
    >Open in wallet</Button
  >[% endif %]
</StageCard>

<style>
  /* one element is the side card, the page card and the drawer, so this undoes
     the browser's [popover] defaults */
  .summary {
    position: static;
    inset: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    inline-size: auto;
    block-size: auto;
    margin: 0;
    padding: var(--space-lg);
    overflow: visible;
    border-inline: none;
    border-block-end: none;
    color: inherit;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-block-size: 0;
  }

  h2 {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
  }

  .top {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .numbers {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-sm);
    min-inline-size: 0;
  }

  .close {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    background: var(--card-color);
    border: none;
    border-radius: var(--radius-full);
    color: var(--heading-color);
    cursor: pointer;
  }

  p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  @media (width < 1200px) {
    h2 {
      display: none;
    }

    .numbers {
      --progress-text-align: start;
    }

    /* without popover support the card stays on the page */
    @supports selector(:popover-open) {
      .summary.drawer {
        --qr-size: 10rem;

        position: fixed;
        inset: auto 0 0;
        inline-size: 100%;
        max-block-size: 90dvh;
        padding: var(--space-md);
        background: var(--bg-color);
        border: none;
        border-radius: var(--radius-xl) var(--radius-xl) 0 0;
        box-shadow: 0 -8px 24px rgb(0 0 0 / 18%);
        transform: translateY(100%);
        transition:
          transform 0.3s cubic-bezier(0.32, 0.72, 0, 1),
          display 0.3s allow-discrete,
          overlay 0.3s allow-discrete;

        &:not(:popover-open) {
          display: none;
        }

        &:popover-open {
          transform: none;

          @starting-style {
            transform: translateY(100%);
          }
        }

        &::backdrop {
          background: var(--scrim-color);
          opacity: 0;
          backdrop-filter: blur(2px);
          transition:
            opacity 0.3s ease,
            display 0.3s allow-discrete,
            overlay 0.3s allow-discrete;
        }

        &:popover-open::backdrop {
          opacity: 1;

          @starting-style {
            opacity: 0;
          }
        }

        .details {
          overflow-y: auto;
        }

        .top {
          gap: var(--space-sm);
        }

        .numbers {
          flex-flow: row wrap;
          justify-content: space-between;
          gap: var(--space-2xs) var(--space-xs);
        }

        .progress {
          display: contents;
        }

        & :global(.progress-text) {
          margin: 0;
        }

        & :global(.progress-track) {
          flex-basis: 100%;
          order: 1;
          margin-block-start: var(--space-2xs);
        }
      }
    }
  }

  @media (width >= 1200px) {
    .close {
      display: none;
    }

    /* a drawer left open on a phone sits where the side card goes, below the
       header, top margin, back link and gap */
    .summary.drawer:popover-open {
      position: fixed;
      inset: 9.625rem
        max(
          var(--desktop-padding-inline),
          calc((100vw - var(--proposal-width)) / 2)
        )
        auto auto;
      inline-size: var(--summary-width);
    }

    .summary.drawer::backdrop {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .summary.drawer,
    .summary.drawer::backdrop {
      transition: none;
    }
  }
</style>
