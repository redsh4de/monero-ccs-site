---
interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

[% if it.funding %]
<div class={className} {...rest}>
  <div class="progress-text">
    Raised [[ it.raised ]] [% if it.amount %]of [[ it.amount ]] [% endif %]XMR
  </div>
  <progress class="progress-track" max="100" value="[[ it.percent ]]"
    >[[ it.percent ]]%</progress
  >
</div>
[% elif it.in_progress and it.milestones %]
<div class={className} {...rest}>
  <div class="progress-text">
    Completed [[ it.milestones_done ]] of [[ it.milestones|length ]] milestones
  </div>
  <div class="milestone-track">
    [% for i in range(it.milestones_done) %]<div
      class="milestone-segment active"
    >
    </div>[% endfor %][% for i in range(it.milestones_left) %]<div
      class="milestone-segment"
    >
    </div>[% endfor %]
  </div>
</div>
[% endif %]

<style>
  .progress-text {
    font-size: var(--font-size-sm);
    margin-block-end: var(--space-xs);
    text-align: var(--progress-text-align, end);
  }

  .progress-track,
  .milestone-segment {
    background-color: color-mix(in srgb, var(--stage-color), transparent 85%);
    border-radius: var(--radius-full);
  }

  .progress-track {
    display: block;
    inline-size: 100%;
    block-size: 8px;
    overflow: hidden;
    border: 0;
    appearance: none;
  }

  .progress-track::-webkit-progress-bar {
    background-color: transparent;
  }

  .progress-track::-webkit-progress-value {
    background-color: var(--stage-color);
  }

  .progress-track::-moz-progress-bar {
    background-color: var(--stage-color);
  }

  .milestone-track {
    display: flex;
    gap: 4px;
    block-size: 8px;
  }

  .milestone-segment {
    flex: 1;
  }

  .milestone-segment.active {
    background-color: var(--stage-color);
  }
</style>
