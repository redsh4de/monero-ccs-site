---
import ProposalProgress from "@/components/pages/proposals/ProposalProgress.astro";
import BottomBar from "@/components/ui/BottomBar.astro";
import Button from "@/components/ui/Button.astro";

// Button's types only allow attributes its tags share, so these need a spread
const disabled = { disabled: true };
const opensSummary = { popovertarget: "summary" };
---

[% if it.funding %]
<BottomBar>
  <div class="contribute-row">
    <ProposalProgress class="progress" />
    [% if it.open %]<Button {...opensSummary}>Contribute</Button>[% else %]<Button
      class="closed"
      variant="secondary"
      {...disabled}
    >
      [% if it.fully_funded %]Fully funded[% else %]Unavailable[% endif %]
    </Button>[% endif %]
  </div>
</BottomBar>
[% endif %]

<style>
  .contribute-row {
    --progress-text-align: start;

    display: flex;
    align-items: center;
    gap: var(--space-md);
    block-size: 100%;
    padding-inline: var(--mobile-padding-inline);
  }

  .progress {
    flex: 1;
    min-inline-size: 0;
  }

  .closed {
    pointer-events: none;
  }

  @media (width >= 1200px) {
    .contribute-row {
      display: none;
    }
  }
</style>
