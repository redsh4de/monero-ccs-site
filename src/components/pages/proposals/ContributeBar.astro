---
import ProposalProgress from "@/components/pages/proposals/ProposalProgress.astro";
import BottomBar from "@/components/ui/BottomBar.astro";
import Button from "@/components/ui/Button.astro";
import type { Proposal } from "@/lib/proposals";

interface Props {
  proposal: Proposal;
}

const { proposal } = Astro.props;

// Button's types only allow attributes its tags share, so these need a spread
const disabled = { disabled: true };
const opensSummary = { popovertarget: "summary" };
---

{
  proposal.status === "funding-required" && (
    <BottomBar>
      <div class="contribute-row">
        <ProposalProgress {proposal} class="progress" />
        {proposal.address ? (
          <Button {...opensSummary}>Contribute</Button>
        ) : (
          <Button class="closed" variant="secondary" {...disabled}>
            {proposal.fullyFunded ? "Fully funded" : "Unavailable"}
          </Button>
        )}
      </div>
    </BottomBar>
  )
}

<style>
  .contribute-row {
    --progress-text-align: start;

    display: flex;
    align-items: center;
    gap: var(--space-md);
    block-size: 100%;
    padding-inline: var(--mobile-padding-inline);
  }

  .progress {
    flex: 1;
    min-inline-size: 0;
  }

  .closed {
    pointer-events: none;
  }

  @media (width >= 1200px) {
    .contribute-row {
      display: none;
    }
  }
</style>
