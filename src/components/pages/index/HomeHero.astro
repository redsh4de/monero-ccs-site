---
import { Image } from "astro:assets";

import landingImage from "@/assets/funding-required.webp";
---

<div class="hero">
  <Image src={landingImage} alt="" width={232} loading="eager" />
  <h1>Community Crowdfunding System</h1>
  <p>
    Monero is a decentralized, community driven project. The CCS is a way for
    the community to fund development and other initiatives that benefit the
    Monero ecosystem.
  </p>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }

  img {
    inline-size: 3.75rem;
    block-size: auto;
  }

  h1 {
    margin: 0;
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-title);
    color: var(--orange-text);
  }

  p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--text-secondary);
  }

  @media (width >= 1200px) {
    .hero {
      gap: var(--space-xs) var(--space-lg);
    }

    img {
      grid-row: 1 / 3;
      inline-size: 7.25rem;
    }

    h1 {
      align-self: end;
      font-size: var(--font-size-3xl);
    }

    p {
      grid-column: 2;
      align-self: start;
      text-wrap: pretty;
    }
  }
</style>
