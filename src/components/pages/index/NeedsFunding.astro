---
import SectionHeading from "@/components/pages/index/SectionHeading.astro";
import ProposalCard from "@/components/pages/proposals/ProposalCard.astro";
---

<section aria-labelledby="funding-title">
  <SectionHeading id="funding-title" title="Needs funding">
    [% if home.see_all %]<a href="/funding-required/"
      >See all [[ home.funding_count ]]</a
    >[% endif %]
  </SectionHeading>
  [% if home.needs_funding %]
  <div class="funding">
    [% for it in home.needs_funding %]<ProposalCard variant="simple" />[% endfor
    %]
  </div>
  [% else %]
  <p>Nothing needs funding right now.</p>
  [% endif %]
</section>

<style>
  .funding {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-md);
  }

  p {
    margin: 0;
    color: var(--text-secondary);
  }

  @media (width >= 1200px) {
    .funding {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
