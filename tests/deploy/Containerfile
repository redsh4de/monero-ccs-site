FROM localhost/ccs-render
RUN apt-get update \
  && apt-get install -y --no-install-recommends gpgv gpg gpg-agent rsync \
    git curl nginx openssl systemd openssh-client python3-pytest \
    openssh-server tor libnss-systemd ca-certificates \
    podman fuse-overlayfs nftables less \
  && rm -rf /var/lib/apt/lists/*
